{
  "name": "dsh-door",
  "version": "0.1.4",
  "description": "dsh-door: mobile BFF plugin for DeepSeek Harness - pairing, session reads, live events, approvals and questions over plain HTTP + SSE.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mobile",
    "door"
  ],
  "license": "MIT",
  "author": "ada87",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ada87/dsh-door.git"
  },
  "homepage": "https://github.com/ada87/dsh-door#readme",
  "bugs": {
    "url": "https://github.com/ada87/dsh-door/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs && npm run build:web",
    "build:web": "tsx --tsconfig web/tsconfig.json web/render.tsx",
    "dev:host": "node build.mjs",
    "dev:web": "tsx watch --tsconfig web/tsconfig.json web/render.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "pretest": "npm run build:web",
    "pack:local": "pnpm pack",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "semver": "^7.7.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
